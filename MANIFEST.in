include qualification_manifest.json release_bundle_manifest.json
include README.md LICENSE CONTRIBUTING.md RELEASE_NOTES.md Makefile requirements*.txt docker-compose.yml Dockerfile .gitignore .dockerignore
recursive-include configs *.yaml
recursive-include constraints *.txt
recursive-include docs *.md *.json
recursive-include scripts *.py
recursive-include tests *.py
recursive-include dashboard *.py
recursive-include reference_results *
recursive-include artifacts .gitkeep
recursive-include data/generated .gitkeep
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude .pytest_cache/*
global-exclude .ruff_cache/*
global-exclude *.sqlite
global-exclude *.pt
global-exclude .coverage
global-exclude .DS_Store
